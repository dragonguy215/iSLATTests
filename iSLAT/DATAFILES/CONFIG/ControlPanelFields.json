{
    "global_fields": {
        "distance": {
            "label": "Distance:",
            "property": "global_distance",
            "datatype": "float",
            "format": "{:.4g}",
            "default": 140.0,
            "width": 7,
            "tip": "Distance to the\nobserved target\nunits: pc"
        },
        "stellar_rv": {
            "label": "Stellar RV:",
            "property": "global_stellar_rv",
            "datatype": "float",
            "format": "{:.4g}",
            "default": 0.0,
            "width": 7,
            "tip": "Radial velocity (helioc.)\nof the observed target\nunits: km/s"
        },
        "model_pixel_res": {
            "label": "Pixel res.",
            "property": "global_model_pixel_res",
            "datatype": "float",
            "format": "{:.6g}",
            "default": 0.02,
            "width": 7,
            "tip": "Model Pixel Resolution\nunits: µm"
        }
    },
    "molecule_fields": {
        "temp": {
            "label": "Temperature:",
            "attribute": "temp",
            "datatype": "float",
            "format": "{:.4g}",
            "default": 300.0,
            "width": 4,
            "tip": "Excitation temperature\nunits: K"
        },
        "radius": {
            "label": "Radius:",
            "attribute": "radius",
            "datatype": "float",
            "format": "{:.4g}",
            "default": 0.5,
            "width": 4,
            "tip": "Equivalent radius\nunits: au"
        },
        "n_mol": {
            "label": "Col. Density:",
            "attribute": "n_mol",
            "datatype": "float",
            "format": "{:.4g}",
            "default": 1e15,
            "width": 7,
            "tip": "Column density\nunits: cm^(-2)"
        },
        "instrumental_profile": {
            "label": "Inst. Profile:",
            "attribute": "instrumental_profile_key",
            "datatype": "str",
            "widget_type": "optionmenu",
            "options": ["constant", "miri_mrs"],
            "option_labels": {"constant": "Constant FWHM", "miri_mrs": "JWST MIRI MRS"},
            "default": "constant",
            "width": 14,
            "tip": "Instrumental line-spread\nfunction profile.\n'Constant FWHM' uses the\ninstrumental FWHM value below.\n'JWST MIRI MRS' uses a\nwavelength-dependent R(λ)."
        },
        "instrumental_fwhm": {
            "label": "Inst. FWHM:",
            "attribute": "fwhm",
            "datatype": "float",
            "format": "{:.4g}",
            "default": 160.0,
            "width": 7,
            "tip": "Instrumental FWHM\n(used when profile = Constant FWHM)\nunits: km/s"
        },
        "keplerian_fwhm": {
            "label": "Kep. FWHM:",
            "attribute": "keplerian_fwhm",
            "datatype": "float",
            "format": "{:.4g}",
            "default": 0.0,
            "width": 7,
            "tip": "Keplerian broadening FWHM\nadded in quadrature with\nthe instrumental profile.\nSet to 0 to disable.\nunits: km/s"
        },
        "broad": {
            "label": "Broadening:",
            "attribute": "broad",
            "datatype": "float",
            "format": "{:.4g}",
            "default": 0.1,
            "width": 7,
            "tip": "Line broadening (FWHM)\n(thermal/turbulence)\nunits: km/s"
        },
        "rv_shift": {
            "label": "RV Shift:",
            "attribute": "rv_shift",
            "datatype": "float",
            "format": "{:.4g}",
            "default": 0.0,
            "width": 7,
            "tip": "Radial velocity (helioc.)\nof the molecule data\nunits: km/s"
        }
    }
}
